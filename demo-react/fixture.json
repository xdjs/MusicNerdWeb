.io/f/weFg7d9YDm6alYsjRG4Ck15vphqZ6xije2r4bDRoASOBVXuP"}, {"siteName": "soundcloud", "href": "https://www.soundcloud.com/ucancallmela", "label": "Soundcloud", "iconSrc": "/siteIcons/soundcloud_icon.svg"}, {"siteName": "farcaster", "href": "https://farcaster.xyz/callmelatasha", "label": "Farcaster", "iconSrc": "https://41xsdnhgxs.ufs.sh/f/weFg7d9YDm6aANyN5IOWaDA9OjtJE4Tz6H0vMR7YpX5FL3ec"}, {"siteName": "discogs", "href": "https://www.discogs.com/artist/213635", "label": "Discogs", "iconSrc": "https://41xsdnhgxs.ufs.sh/f/weFg7d9YDm6ayO9lU4o8jbf0ZXp3IW2kzvK7mUoCwituY4aN"}, {"siteName": "bandcamp", "href": "https://callmelatasha.bandcamp.com/", "label": "Bandcamp", "iconSrc": "/siteIcons/bandcamp_icon.svg"}, {"siteName": "zora", "href": "https://zora.co/callmelatasha", "label": "Zora", "iconSrc": "https://41xsdnhgxs.ufs.sh/f/weFg7d9YDm6auCaO06RTeRFJZL0oYjmskQX1hU4KvlqrWPfb"}], "latest": [{"id": "instagram:0e3568a3-39b2-4ec4-bd26-ad3bf2196913", "kind": "instagram", "title": "From Instagram", "text": "What\u2019s better than one \ud83d\udc08\u200d\u2b1b? \n\ud83d\udc08\u200d\u2b1b\ud83d\udc08\u200d\u2b1b\n\nPPNE NYC MUSIC VISUALIZER is officially out. \nFilmed by @justnichochung + @sen.floyd \nMusic produced by @callmelatasha + @whoiseli \nExecutive Produced by @cxy", "date": "2026-10-05 19:43:02+00", "imageUrl": "/demo-assets/19065a443df001a5.webp", "imageCaption": "Instagram post by LATASH\u00c1", "imageDimensions": null, "sourceUrl": "https://www.instagram.com/p/DeH-zaDygKO/", "sourceLabel": "View on Instagram"}, {"id": "instagram:38ed02e6-2a51-4d75-bdb5-91212547333a", "kind": "instagram", "title": "From Instagram", "text": "we been crossing thresholds.\n\nThanks @musiccrowns, @rollinghype, @ventsmagazineuk, @ukmusictimes, @cdbaby and @plasticmgzn for bringing the world to OUT HERE.\n\nPhotography by @margaretmurphyart \nPress photography by @alon.raw \nBody Art by @chesphinx", "date": "2026-10-02 19:21:48+00", "imageUrl": "/demo-assets/abdfa101df764ffa.webp", "imageCaption": "Instagram post by LATASH\u00c1", "imageDimensions": null, "sourceUrl": "https://www.instagram.com/p/DeAOVi0EpFa/", "sourceLabel": "View on Instagram"}, {"id": "instagram:22e837b9-35da-42aa-8f0d-d4d634853e4a", "kind": "instagram", "title": "From Instagram", "text": "Ahhhhhh! My new album is not even an album. It\u2019s an experiential understanding of full self awareness and party.", "date": "2026-10-01 21:32:00+00", "imageUrl": "/demo-assets/ab6de8234b1ffd74.webp", "imageCaption": "Instagram post by LATASH\u00c1", "imageDimensions": null, "sourceUrl": "https://www.instagram.com/p/Dd94RaTy4KP/", "sourceLabel": "View on Instagram"}, {"id": "instagram:8c8636d7-1446-46a0-8b23-293bb5158355", "kind": "instagram", "title": "From Instagram", "text": "A song for that\u2019s a reminder. May it affirm you down. Love you up. And raise your power levels. Glamour magic.", "date": "2026-09-30 19:59:26+00", "imageUrl": "/demo-assets/4e7b316903a26144.webp", "imageCaption": "Instagram post by LATASH\u00c1", "imageDimensions": null, "sourceUrl": "https://www.instagram.com/p/Dd7Iy2NylG5/", "sourceLabel": "View on Instagram"}, {"id": "instagram:422d91fd-8072-4fd9-a8a3-ff57ccb0e84d", "kind": "instagram", "title": "From Instagram", "text": "DAY 003: OUT HERE getting my crib together, remembering what holds me. \ud83d\uddfd\n\na Sunday reset turned into a look back at making PPNE in New York. my city, my people, and the reminder that you can still be figuring it out and make something beautiful.\n\nBig love to @rockysnyda @hotnfun.irl @sen.floyd @justnichochung @sibbyliv and all my girls on the PPNE shoot. (@christine.ashley , @vivisvvss, @chellyworldink, @kimxkilla ) also still very obsessed with these pieces from @kaicollective \n\nAlso thanks stink for my matcha from @oliveandjamescafetea @artbyjah.\n\nlove to everyone who helped bring this vision to life. OUT HERE is running it up out here. see you tomorrow. \ud83d\udda4", "date": "2026-09-29 01:39:53+00", "imageUrl": "/demo-assets/233e572a1c213131.webp", "imageCaption": "Instagram post by LATASH\u00c1", "imageDimensions": null, "sourceUrl": "https://www.instagram.com/p/Dd2mJlJSQig/", "sourceLabel": "View on Instagram"}, {"id": "instagram:8c12104f-ae05-4fa4-81b8-af32e75b9f93", "kind": "instagram", "title": "From Instagram", "text": "just the girls reminding yall as always. \n\nPPNE on OUT HERE now.", "date": "2026-09-28 19:36:30+00", "imageUrl": "/demo-assets/750b8026773e1fd8.webp", "imageCaption": "Instagram post by LATASH\u00c1", "imageDimensions": null, "sourceUrl": "https://www.instagram.com/p/Dd18jkOy_wT/", "sourceLabel": "View on Instagram"}, {"id": "instagram:4d89dcf1-7a2c-4484-92bd-c76119a1620b", "kind": "instagram", "title": "From Instagram", "text": "DAY 002 of life after releasing OUT HERE \ud83c\udf19\n\nI carried this project for over 5 years and now baby girl has me up at 5 AM with a to-do list \ud83d\ude2d\n\nMe and @artbyjah both woke up with something to create. A little makeup, a new book, and then outside to be inspired by my people.\n\nPicked up BLACK MEME by @ellerustle after @eileenonline_ said so. Took my first modeling class with @diiana_en and got in front of @photographedbycaleb lens. Diana, all the flowers for you \ud83e\udd0d Modeling for @ouithepeople earlier this year gave me the bug. Time to build that portfolio.\n\nThen @ezra_ost went crazy at @beatsfreaksgeeks and took me right back to the Eye Stay Gold days in NYC.\n\nSeeing my people do what they love reminds me to keep going. Proud of yall. Thank you for all the love on OUT HERE. Y\u2019all are light.\n\nSee you tomorrow \ud83d\udda4", "date": "2026-09-28 01:00:06+00", "imageUrl": "/demo-assets/13f6621d490f6555.webp", "imageCaption": "Instagram post by LATASH\u00c1", "imageDimensions": {"width": 361, "height": 640}, "sourceUrl": "https://www.instagram.com/p/Ddz9ICGul-n/", "sourceLabel": "View on Instagram"}, {"id": "instagram:1ace21bc-dc9f-4531-ad8d-58bd9d9cb4de", "kind": "instagram", "title": "From Instagram", "text": "what if you are your highest self? \n\nTY every1 who pulled up to Sonic Botanica 001: OUT HERE listening experience and met TASHI. \n\nFull recap on the way and more on her soon. \nPhotography by our new fave @ch4mberlin", "date": "2026-09-27 22:13:26+00", "imageUrl": "/demo-assets/a7ed54b77d1a9f70.webp", "imageCaption": "Instagram post by LATASH\u00c1", "imageDimensions": null, "sourceUrl": "https://www.instagram.com/p/DdzqAUsEj1e/", "sourceLabel": "View on Instagram"}, {"id": "instagram:6b7223aa-b379-4933-b112-e55004baec87", "kind": "instagram", "title": "From Instagram", "text": "what\u2019s it like releasing a project in this new world? We gonna find out. This is DAYS:OUT HERE, my daily visual ritual catching life building my world and being out here.\n\nlife after releasing independently is all the emotions. celebrating with my love @artbyjah__ , getting back in my body with @jazmyn_thomas and dreaming up the next Sonic Botanica at @orbitalvirtualstudios \nthen outside with @anajordyn_ at @beatport Connect. @slowkey, @the.bitter.life and @traceymanner had me thinking bigger about partnerships and what\u2019s possible. running into @shesmaad and meeting @officiallymkei made the day even sweeter. @cquestt @baileworld sad I missed you and didn\u2019t get to say hi!\n\ntrying to stay present and give the universe some room to do the big ones\u2026 instead of refreshing my phone all day \ud83d\ude2d\n\nthank you for listening, sharing, and showing up. keep OUT HERE in rotation. we got places to go.\nsee you tomorrow. \ud83e\ude76", "date": "2026-09-26 19:00:08+00", "imageUrl": "/demo-assets/3904d4ab2eda72d0.webp", "imageCaption": "Instagram post by LATASH\u00c1", "imageDimensions": {"width": 360, "height": 640}, "sourceUrl": "https://www.instagram.com/p/DdwvHp3O2Eq/", "sourceLabel": "View on Instagram"}, {"id": "release:deezer:1078909692", "kind": "release", "title": "Out Here", "text": "Album by LATASH\u00c1", "date": "2026-09-25", "imageUrl": "/demo-assets/fe7b7ee940a433fe.jpg", "imageCaption": "Out Here artwork", "sourceUrl": "https://www.deezer.com/album/1078909692", "listeningLinks": [{"siteName": "deezer", "href": "https://www.deezer.com/album/1078909692", "label": "Deezer", "iconSrc": "/siteIcons/deezer_icon.svg"}, {"siteName": "spotify", "href": "https://open.spotify.com/album/21rCa5rj1qSEpvIFwe2lOB", "label": "Spotify", "iconSrc": "/siteIcons/spotify_icon.svg"}], "sourceLabel": "Listen on Deezer"}, {"id": "release:deezer:1019828801", "kind": "release", "title": "You Da Shh Girl", "text": "Single by LATASH\u00c1", "date": "2026-07-31", "imageUrl": "/demo-assets/8490a29ea1e800be.jpg", "imageCaption": "You Da Shh Girl artwork", "sourceUrl": "https://www.deezer.com/album/1019828801", "listeningLinks": [{"siteName": "deezer", "href": "https://www.deezer.com/album/1019828801", "label": "Deezer", "iconSrc": "/siteIcons/deezer_icon.svg"}, {"siteName": "spotify", "href": "https://open.spotify.com/album/5387iaY8zj32RjDzhnk3XX", "label": "Spotify", "iconSrc": "/siteIcons/spotify_icon.svg"}], "sourceLabel": "Listen on Deezer"}, {"id": "release:deezer:997087291", "kind": "release", "title": "PPNE", "text": "Single by LATASH\u00c1", "date": "2026-06-26", "imageUrl": "/demo-assets/ffdf2244419781c6.jpg", "imageCaption": "PPNE artwork", "sourceUrl": "https://www.deezer.com/album/997087291", "listeningLinks": [{"siteName": "deezer", "href": "https://www.deezer.com/album/997087291", "label": "Deezer", "iconSrc": "/siteIcons/deezer_icon.svg"}, {"siteName": "spotify", "href": "https://open.spotify.com/album/266NPOIgEfBzf2n1QjOsbb", "label": "Spotify", "iconSrc": "/siteIcons/spotify_icon.svg"}], "sourceLabel": "Listen on Deezer"}]}